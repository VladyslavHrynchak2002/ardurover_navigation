    <link name='front_camera_link'>
      <!-- Camera is mounted below and slightly in front of the LiDAR to avoid blocking Livox scan -->
      <pose>0.38 0 0.16 0 0 0</pose>

      <inertial>
        <mass>0.03</mass>
        <inertia>
          <ixx>0.00001</ixx>
          <iyy>0.00001</iyy>
          <izz>0.00001</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <visual name='front_camera_body'>
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.055 0.035 0.035</size>
          </box>
        </geometry>
        <material>
          <ambient>0.02 0.02 0.02 1</ambient>
          <diffuse>0.02 0.02 0.02 1</diffuse>
        </material>
      </visual>

      <visual name='front_camera_lens'>
        <pose>0.030 0 0 0 1.5708 0</pose>
        <geometry>
          <cylinder>
            <radius>0.011</radius>
            <length>0.006</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0 0 0 1</ambient>
          <diffuse>0 0 0 1</diffuse>
        </material>
      </visual>

      <collision name='front_camera_collision'>
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.055 0.035 0.035</size>
          </box>
        </geometry>
      </collision>
    </link>

    <joint name='front_camera_joint' type='fixed'>
      <parent>base_link</parent>
      <child>front_camera_link</child>
    </joint>

    <joint name='lidar_joint' type='fixed'>
      <parent>base_link</parent>
      <child>lidar_link</child>
    </joint>

    <static>0</static>

    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_frame>map</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <odom_publish_frequency>50</odom_publish_frequency>
      <odom_topic>/ground_truth/odom</odom_topic>
      <dimensions>3</dimensions>
    </plugin>

    <plugin name="ArduPilotPlugin" filename="ArduPilotPlugin">
      <fdm_addr>127.0.0.1</fdm_addr>
      <fdm_port_in>9002</fdm_port_in>
      <connectionTimeoutMaxCount>5</connectionTimeoutMaxCount>
      <lock_step>1</lock_step>
      <no_time_sync>1</no_time_sync>
      <have_32_channels>0</have_32_channels>

      <modelXYZToAirplaneXForwardZDown degrees="true">0 0 0 0 0 0</modelXYZToAirplaneXForwardZDown>
      <gazeboXYZToNED degrees="true">0 0 0 180 0 90</gazeboXYZToNED>

      <imuName>base_link::imu_sensor</imuName>

      <!-- Left side: SERVO1_FUNCTION 73, ArduPilot channel 0 -->
      <control channel="0">
        <jointName>motor_0</jointName>
        <useForce>0</useForce>
        <multiplier>80</multiplier>
        <offset>-0.5</offset>
        <servo_min>1100</servo_min>
        <servo_max>1900</servo_max>
        <type>VELOCITY</type>
        <p_gain>5.0</p_gain>
        <i_gain>0</i_gain>
        <d_gain>0</d_gain>
        <i_max>0</i_max>
        <i_min>0</i_min>
        <cmd_max>40</cmd_max>
        <cmd_min>-40</cmd_min>
      </control>

      <control channel="1">
        <jointName>motor_1</jointName>
        <useForce>0</useForce>
        <multiplier>80</multiplier>
        <offset>-0.5</offset>
        <servo_min>1100</servo_min>
        <servo_max>1900</servo_max>
        <type>VELOCITY</type>
        <p_gain>5.0</p_gain>
        <i_gain>0</i_gain>
        <d_gain>0</d_gain>
        <i_max>0</i_max>
        <i_min>0</i_min>
        <cmd_max>40</cmd_max>
        <cmd_min>-40</cmd_min>
      </control>

      <!-- Right side: SERVO3_FUNCTION 74, ArduPilot channel 2 -->
      <control channel="2">
        <jointName>motor_2</jointName>
        <useForce>0</useForce>
        <multiplier>-80</multiplier>
        <offset>-0.5</offset>
        <servo_min>1100</servo_min>
        <servo_max>1900</servo_max>
        <type>VELOCITY</type>
        <p_gain>5.0</p_gain>
        <i_gain>0</i_gain>
        <d_gain>0</d_gain>
        <i_max>0</i_max>
        <i_min>0</i_min>
        <cmd_max>40</cmd_max>
        <cmd_min>-40</cmd_min>
      </control>

      <control channel="3">
        <jointName>motor_3</jointName>
        <useForce>0</useForce>
        <multiplier>-80</multiplier>
        <offset>-0.5</offset>
        <servo_min>1100</servo_min>
        <servo_max>1900</servo_max>
        <type>VELOCITY</type>
        <p_gain>5.0</p_gain>
        <i_gain>0</i_gain>
        <d_gain>0</d_gain>
        <i_max>0</i_max>
        <i_min>0</i_min>
        <cmd_max>40</cmd_max>
        <cmd_min>-40</cmd_min>
      </control>
    </plugin>

    <plugin
      filename="gz-sim-joint-state-publisher-system"
      name="gz::sim::systems::JointStatePublisher">
      <joint_name>motor_0</joint_name>
      <joint_name>motor_1</joint_name>
      <joint_name>motor_2</joint_name>
      <joint_name>motor_3</joint_name>
    </plugin>
  </model>
</sdf>